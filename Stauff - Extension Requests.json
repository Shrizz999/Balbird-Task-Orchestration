    {
      "parameters": {
        "jsCode": "const rawText = $input.first().json[\"Paste The JSON\"]; \nconst payload = JSON.parse(rawText);\nconst goalsData = payload.goals || {};\nconst splitItems = [];\n\nconst DEPT_MAP = {\n  \"Ganesh\": \"PO department\",\n  \"Shreyash\": \"SO department\",\n  \"Shruti\": \"Sales Department\",\n  \"Vaishnavi\": \"Logistics Department\"\n};\n\nfor (const [name, details] of Object.entries(goalsData)) {\n  const dateStr = new Date().toISOString().slice(2, 10).replace(/-/g, '');\n  const shortHash = Math.random().toString(36).substring(2, 6).toUpperCase();\n  const dept = DEPT_MAP[name] || \"Other\";\n  splitItems.push({\n    json: {\n      \"task_id\": `TSK-${dateStr}-${name.substring(0,3).toUpperCase()}-${shortHash}`,\n      \"date\": new Date().toLocaleDateString('en-GB'),\n      \"description\": details.goal || details,\n      \"assigned_to\": name,\n      \"assigned_by\": \"Manager\",\n      \"department\": dept,\n      \"deadline\": details.deadline || \"\",\n      \"priority\": details.priority || \"Normal\",\n      \"status\": \"Pending\",\n      \"reason\": \"\",\n      \"source\": \"Daily Goals Input\",\n      \"updated_by\": \"n8n Automation\",\n      \"last_updated\": new Date().toISOString()\n    }\n  });\n}\nreturn splitItems;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2464,
        1168
      ],
      "id": "5f2a689b-e2d8-4c80-ae19-2b1c1fe1182b",
      "name": "Format Daily Goals"
    },
    {
      "parameters": {
        "jsCode": "const rawText = $input.first().json[\"Paste The JSON\"]; \nconst payload = JSON.parse(rawText);\nconst goalsData = payload.goals || {};\nconst splitItems = [];\n\nfor (const [dept, goal] of Object.entries(goalsData)) {\n  const dateStr = new Date().toISOString().slice(2, 10).replace(/-/g, '');\n  const shortHash = Math.random().toString(36).substring(2, 6).toUpperCase();\n  splitItems.push({\n    json: {\n      \"goal_id\": `GOAL-${dateStr}-${dept.substring(0,3).toUpperCase()}-${shortHash}`,\n      \"time_frame\": \"Monthly\",\n      \"week_month\": new Date().toLocaleString('default', { month: 'long', year: 'numeric' }),\n      \"assigned_to\": dept,\n      \"given_by\": \"UI Input / Manager\",\n      \"goal\": goal,\n      \"deadline\": \"End of Month\",\n      \"status\": \"Pending\",\n      \"reason\": \"\",\n      \"updated_by\": \"n8n Automation\",\n      \"last_updated\": new Date().toISOString()\n    }\n  });\n}\nreturn splitItems;"
      },
