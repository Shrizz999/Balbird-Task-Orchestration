    {
      "parameters": {
        "jsCode": "const rawText = $input.first().json[\"Paste The JSON\"]; \nconst payload = JSON.parse(rawText);\nconst goalsData = payload.goals || {};\nconst splitItems = [];\n\nconst DEPT_MAP = {\n  \"Ganesh\": \"PO department\",\n  \"Shreyash\": \"SO department\",\n  \"Shruti\": \"Sales Department\",\n  \"Vaishnavi\": \"Logistics Department\"\n};\n\nfor (const [name, detailsList] of Object.entries(goalsData)) {\n  // Fix: Ensure we always iterate over an array of tasks\n  const items = Array.isArray(detailsList) ? detailsList : [detailsList];\n  \n  for (const details of items) {\n    const dateStr = new Date().toISOString().slice(2, 10).replace(/-/g, '');\n    const shortHash = Math.random().toString(36).substring(2, 6).toUpperCase();\n    const dept = DEPT_MAP[name] || \"Other\";\n    \n    splitItems.push({\n      json: {\n        \"task_id\": `TSK-${dateStr}-${name.substring(0,3).toUpperCase()}-${shortHash}`,\n        \"date\": details.date || new Date().toLocaleDateString('en-GB'),\n        \"description\": details.goal || details.task || details, // Now correctly grabs the text\n        \"assigned_to\": name,\n        \"assigned_by\": \"Manager\",\n        \"department\": dept,\n        \"deadline\": details.deadline || \"\",\n        \"priority\": details.priority || \"Normal\",\n        \"status\": \"Pending\",\n        \"checklist\": details.checklist || [],\n        \"reason\": \"\",\n        \"source\": \"Daily Goals Input\",\n        \"updated_by\": \"n8n Automation\",\n        \"last_updated\": new Date().toISOString()\n      }\n    });\n  }\n}\nreturn splitItems;\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -3392,
        -848
      ],
      "id": "b9f569bb-0fac-4a94-b019-859522c09de9",
      "name": "Format Daily Goals"
