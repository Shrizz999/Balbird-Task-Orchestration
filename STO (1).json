    {
      "parameters": {
        "jsCode": "const rawText = $input.first().json[\"Paste The JSON\"]; \nconst payload = JSON.parse(rawText);\nconst goalsData = payload.goals || {};\nconst splitItems = [];\n\nfor (const [dept, detailsList] of Object.entries(goalsData)) {\n  // Fix: Ensure we iterate over the array of monthly goals\n  const items = Array.isArray(detailsList) ? detailsList : [detailsList];\n  \n  for (const details of items) {\n    const dateStr = new Date().toISOString().slice(2, 10).replace(/-/g, '');\n    const shortHash = Math.random().toString(36).substring(2, 6).toUpperCase();\n    \n    splitItems.push({\n      json: {\n        \"goal_id\": `GOAL-${dateStr}-${dept.substring(0,3).toUpperCase()}-${shortHash}`,\n        \"time_frame\": \"Monthly\",\n        \"week_month\": details.month || new Date().toLocaleString('default', { month: 'long', year: 'numeric' }),\n        \"assigned_to\": dept,\n        \"given_by\": \"UI Input / Manager\",\n        \"goal\": details.goal || details.task || details, // Correctly grabs the string\n        \"deadline\": details.deadline || \"End of Month\",\n        \"status\": \"Pending\",\n        \"checklist\": details.checklist || [],\n        \"reason\": \"\",\n        \"updated_by\": \"n8n Automation\",\n        \"last_updated\": new Date().toISOString()\n      }\n    });\n  }\n}\nreturn splitItems;\n"
      },
