    {
      "parameters": {
        "jsCode": "const rawInput = $('On form submission').first().json['Paste The JSON'];\nlet finalTranscript = \"\";\nlet individualUpdates = {};\n\ntry {\n    const parsedData = JSON.parse(rawInput);\n    finalTranscript = parsedData.transcript || \"\";\n    individualUpdates = parsedData.individual_updates || {};\n} catch (e) {\n    finalTranscript = rawInput;\n}\n\nlet dailyContext = [];\nlet monthlyContext = [];\nlet sopsContext = [];\ntry {\n    const sops = $('Fetch SOPs').all() || [];\n    sopsContext = sops.map(item => item.json);\n} catch(e) {}\n\ntry {\n    const allTasks = $('Fetch All Tasks Context').all() || [];\n    dailyContext = allTasks.map(item => item.json).filter(item => Object.keys(item).length > 0 && item[\"Task ID\"]);\n} catch(e) {}\n\ntry {\n    const rawMonthly = $('Fetch Monthly Context').all() || [];\n    monthlyContext = rawMonthly.map(item => item.json).filter(item => Object.keys(item).length > 0 && item[\"Goal ID\"]);\n} catch(e) {}\n\nreturn [{ json: { transcript: finalTranscript, individual_updates: individualUpdates, daily_context: dailyContext, monthly_context: monthlyContext, sops: sopsContext } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -2608,
