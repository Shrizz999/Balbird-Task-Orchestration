    {
      "parameters": {
        "jsCode": "const text = $input.first().json.text || \"\";\nlet cleanText = text;\nconst firstBrace = cleanText.indexOf('{');\nconst lastBrace = cleanText.lastIndexOf('}');\nif (firstBrace !== -1 && lastBrace !== -1) { cleanText = cleanText.substring(firstBrace, lastBrace + 1); }\n\nlet parsed = { Tasks: [], Reports: [] };\ntry { parsed = JSON.parse(cleanText); } catch (e) { console.log(\"LLM Parse Error:\", e); }\nconst tasks = parsed.Tasks || [];\n\nconst DEPT_MAP = { \"Ganesh\": \"PO department\", \"Shreyash\": \"SO department\", \"Shruti\": \"Sales Department\", \"Vaishnavi\": \"Logistics Department\" };\n\nreturn tasks.map(t => {\n    const safeName = (t.Assigned_To || \"UNK\").substring(0,3).toUpperCase();\n    const dateStr = new Date().toISOString().slice(2, 10).replace(/-/g, '');\n    const shortHash = Math.random().toString(36).substring(2, 6).toUpperCase();\n    const taskId = (t.Task_ID && t.Task_ID.trim() !== \"\") ? t.Task_ID : `TSK-${dateStr}-${safeName}-${shortHash}`;\n    const dept = DEPT_MAP[t.Assigned_To] || \"Other\";\n    return { json: { \"Task ID\": taskId, \"Date\": new Date().toLocaleDateString('en-GB'), \"Task Description\": t.Task_Description || \"-\", \"Assigned To\": t.Assigned_To || \"-\", \"Assigned By\": t.Assigned_By || \"-\", \"Department\": dept, \"Deadline\": t.Deadline || \"\", \"Priority\": \"Normal\", \"Status\": t.Status || \"Pending\", \"Reason\": t.Reason || \"\", \"Source\": t.Source || \"Meeting Transcript\", \"Updated By\": \"n8n Automation\", \"Last Updated\": new Date().toISOString() } };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [3584, 864],
      "id": "933f7d99-53d2-4880-82ad-a7c927b0fb76",
      "name": "Extract & Map Tasks"
    },
    {
      "parameters": {
        "jsCode": "const text = $input.first().json.text || \"\";\nlet cleanText = text;\nconst firstBrace = cleanText.indexOf('{');\nconst lastBrace = cleanText.lastIndexOf('}');\nif (firstBrace !== -1 && lastBrace !== -1) { cleanText = cleanText.substring(firstBrace, lastBrace + 1); }\nlet parsed = { Tasks: [], Reports: [] };\ntry { parsed = JSON.parse(cleanText); } catch (e) { console.log(\"LLM Parse Error:\", e); }\nreturn (parsed.Reports || []).map(r => { r.Date = new Date().toLocaleDateString('en-GB'); return { json: r }; });"
      },
