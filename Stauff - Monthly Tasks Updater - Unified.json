    {
      "parameters": {
        "jsCode": "const rawText = $input.first().json[\"Paste The JSON\"]; \nconst payload = JSON.parse(rawText);\nconst goalsData = payload.goals || {};\nconst splitItems = [];\n\nconst DEPT_MAP = {\n  \"Ganesh\": \"PO department\",\n  \"Shreyash\": \"SO department\",\n  \"Shruti\": \"Sales Department\",\n  \"Vaishnavi\": \"Logistics Department\"\n};\n\nfor (const [name, details] of Object.entries(goalsData)) {\n  const dateStr = new Date().toISOString().slice(2, 10).replace(/-/g, '');\n  const shortHash = Math.random().toString(36).substring(2, 6).toUpperCase();\n  const dept = DEPT_MAP[name] || \"Other\";\n  splitItems.push({\n    json: {\n      \"Task ID\": `TSK-${dateStr}-${name.substring(0,3).toUpperCase()}-${shortHash}`,\n      \"Date\": new Date().toLocaleDateString('en-GB'),\n      \"Task Description\": details.goal || details,\n      \"Assigned To\": name,\n      \"Assigned By\": \"Manager\",\n      \"Department\": dept,\n      \"Deadline\": details.deadline || \"\",\n      \"Priority\": details.priority || \"Normal\",\n      \"Status\": \"Pending\",\n      \"Reason\": \"\",\n      \"Source\": \"Daily Goals Input\",\n      \"Updated By\": \"n8n Automation\",\n      \"Last Updated\": new Date().toISOString()\n    }\n  });\n}\nreturn splitItems;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2384, 464],
      "id": "6ae23538-d5ef-4d91-9e98-90b079a8a250",
      "name": "Format Daily Goals"
    },
    {
      "parameters": {
        "jsCode": "const rawText = $input.first().json[\"Paste The JSON\"]; \nconst payload = JSON.parse(rawText);\nconst goalsData = payload.goals || {};\nconst splitItems = [];\n\nfor (const [dept, goal] of Object.entries(goalsData)) {\n  const dateStr = new Date().toISOString().slice(2, 10).replace(/-/g, '');\n  const shortHash = Math.random().toString(36).substring(2, 6).toUpperCase();\n  splitItems.push({\n    json: {\n      \"Goal ID\": `GOAL-${dateStr}-${dept.substring(0,3).toUpperCase()}-${shortHash}`,\n      \"Time Frame\": \"Monthly\",\n      \"Week/Month\": new Date().toLocaleString('default', { month: 'long', year: 'numeric' }),\n      \"Assigned To\": dept,\n      \"Given By\": \"UI Input / Manager\",\n      \"Goal\": goal,\n      \"Deadline\": \"End of Month\",\n      \"Status\": \"Pending\",\n      \"Reason\": \"\",\n      \"Updated By\": \"n8n Automation\",\n      \"Last Updated\": new Date().toISOString()\n    }\n  });\n}\nreturn splitItems;"
      },
